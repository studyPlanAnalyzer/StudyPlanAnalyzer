# Neon Postgres connection string. Create a project at https://neon.tech,
# then copy the pooled connection string from the dashboard.
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=verify-full"

# SSL mode for the Postgres connection. Leave unset for Neon (default:
# verified TLS using Node's built-in CA trust store — Neon's certs are
# signed by a public CA, so no custom certificate needs to be provided).
# Set to "disable" only for a local Postgres instance that doesn't run
# with TLS at all. Never set this to "disable" against Neon or any other
# production endpoint.
# DB_SSL_MODE="disable"

# Signs the sign-in access tokens (HS256). Must be at least 256 bits;
# production refuses to start signing with anything shorter or with this
# placeholder. Generate one with: openssl rand -base64 32
JWT_SECRET="your-secret-key-change-in-production"

# Other origins (comma-separated, scheme + host, no trailing slash) allowed to
# call the API from a browser with credentials. The app's own origin is always
# allowed; leave this unset unless another site of yours calls the API.
# ALLOWED_ORIGINS="https://admin.example.com"

# Development only (ignored in production): set to "true" if your browser
# (e.g. Safari) refuses Secure cookies on http://localhost. Cookies then lose
# the Secure flag and their __Host-/__Secure- name prefixes.
# AUTH_COOKIE_INSECURE="true"

NEXT_PUBLIC_APP_NAME="StudyPlan Analyzer"

# Google sign-in (the only way to sign in). The OAuth client ID from Google
# Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs, type
# "Web application"). The server checks every Google ID token against
# GOOGLE_CLIENT_ID; the sign-in button uses NEXT_PUBLIC_GOOGLE_CLIENT_ID. Both
# hold the same value. No client secret is needed.
GOOGLE_CLIENT_ID="1234567890-abc123.apps.googleusercontent.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="1234567890-abc123.apps.googleusercontent.com"

# Google emails (comma-separated) that are admins. Set on every sign-in,
# compared case-insensitively. Empty or unset: nobody is an admin.
ADMIN_EMAILS="you@gmail.com"
