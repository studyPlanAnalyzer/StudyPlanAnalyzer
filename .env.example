# Neon Postgres connection string. Create a project at https://neon.tech,
# then copy the pooled connection string from the dashboard.
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# SSL mode for the Postgres connection. Leave unset for Neon (default:
# verified TLS using Node's built-in CA trust store — Neon's certs are
# signed by a public CA, so no custom certificate needs to be provided).
# Set to "disable" only for a local Postgres instance that doesn't run
# with TLS at all. Never set this to "disable" against Neon or any other
# production endpoint.
# DB_SSL_MODE="disable"

# Any long random string. Generate one with: openssl rand -base64 32
JWT_SECRET="your-secret-key-change-in-production"

NEXT_PUBLIC_APP_NAME="StudyPlan Analyzer"

RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="StudyPlan Analyzer <onboarding@resend.dev>"